# Copy this file to .env.bootstrap. Never commit the populated file.
COMPOSE_PROJECT_NAME=light-portal-bootstrap

# Logical Portal host and the dedicated Config Server identity selected by startup.yml.
CUSTOMER_PORTAL_HOST=dev.yourcompany.com
PORTAL_BFF_SSO_SERVICE_ID=com.yourcompany.portal.bff.sso-1.0.0
PORTAL_BFF_SSO_ENVIRONMENT=dev
PORTAL_BFF_SSO_HOST_PORT=8445

# Microsoft Entra SPA registration. The redirect URI is consumed at Portal View build time.
MSAL_TENANT_ID=replace-with-tenant-id
MSAL_CLIENT_ID=replace-with-spa-client-id
MSAL_REDIRECT_URI=https://dev.yourcompany.com/authorization

# Confidential light-oauth client authorized for token exchange.
MSAL_EXCHANGE_CLIENT_ID=replace-with-token-exchange-client-id
MSAL_EXCHANGE_CLIENT_SECRET=replace-with-token-exchange-client-secret

# Bootstrap token used only to retrieve this BFF's Config Server snapshot.
PORTAL_BFF_SSO_LIGHT_PORTAL_AUTHORIZATION=Bearer replace-with-portal-bootstrap-token

# Lax is preferred when the SPA and BFF are same-site. Use None only when cross-site cookies are required.
MSAL_COOKIE_SAME_SITE=Lax
PORTAL_BFF_SSO_RUST_LOG=info
